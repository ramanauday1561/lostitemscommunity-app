{
  "expo": {
    "name": "Lost Items Community",
    "slug": "lostitemscommunity-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "community.lostitems.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "community.lostitems.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F2F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Lost Items Community",
      "shortName": "Lost Items",
      "themeColor": "#F2F2F0",
      "backgroundColor": "#F2F2F0"
    },
    "scheme": "lostitems",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lost Items Community needs your photo library so you can attach a photo of the item you are reporting."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lost Items Community uses your location only to drop a pin where you lost or found something."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
