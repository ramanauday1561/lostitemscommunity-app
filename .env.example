# Copy to .env and fill in from the Supabase dashboard (Project Settings > API).
# These EXPO_PUBLIC_ values are bundled into the client and are safe to ship --
# they're protected by Row Level Security, not by secrecy. The service role
# key is a different matter: it must NEVER be prefixed EXPO_PUBLIC_ or added
# here. See backend/README.md.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
