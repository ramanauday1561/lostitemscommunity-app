    "heroui-native": "^1.0.9",
    "maplibre-gl": "^6.12.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
