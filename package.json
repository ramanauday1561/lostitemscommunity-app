  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start --web",
    "export:web": "expo export -p web --output-dir dist",
    "test:api": "tsx --test tests/api/*.test.ts",
    "test": "npm run test:api && npm run test:state && npm run test:functions && npm run test:lib",
    "test:state": "tsx --test tests/state/*.test.ts",
    "test:functions": "tsx --test tests/functions/*.test.ts",
    "test:lib": "tsx --test tests/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id tqkmpirusmdckccqfxyd > src/lib/database.types.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "private": true
